		<label>@text/channel-group.PV_4_Panels.label</label>
		<channels>
			<channel id="State" typeId="PV_State"/>
			<channel id="Power" typeId="Power_in_W">
				<label>@text/channel.PV#Power.label</label>
				<description>@text/channel.PV#Power.description</description>
			</channel>
			<channel id="PowerPanel_1" typeId="Power_in_W">
				<label>@text/channel.PV#PowerPanel_1.label</label>
				<description>@text/channel.PV#PowerPanel_1.description</description>
			</channel>
			<channel id="PowerPanel_2" typeId="Power_in_W">
				<label>@text/channel.PV#PowerPanel_2.label</label>
				<description>@text/channel.PV#PowerPanel_2.description</description>
			</channel>
			<channel id="PowerPanel_3" typeId="Power_in_W">
				<label>@text/channel.PV#PowerPanel_3.label</label>
				<description>@text/channel.PV#PowerPanel_3.description</description>
			</channel>
			<channel id="PowerPanel_4" typeId="Power_in_W">
				<label>@text/channel.PV#PowerPanel_4.label</label>
				<description>@text/channel.PV#PowerPanel_4.description</description>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="BatteryPack">
		<label>@text/channel-group.BatteryPack.label</label>
		<channels>
			<channel id="PackState" typeId="BatteryPack_PackState"/>
			<channel id="Bypass" typeId="BatteryPack_Bypass"/>
			<channel id="DcState" typeId="BatteryPack_DcState"/>
			<channel id="SocState" typeId="BatteryPack_SocState"/>
			<channel id="CalibrationTime" typeId="BatteryPack_CalibrationTime"/>
			<channel id="Heating" typeId="On_Off">
				<label>@text/channel.BatteryPack#Heating.label</label>
				<description>@text/channel.BatteryPack#Heating.description</description>
			</channel>
			<channel id="Power" typeId="Power_in_W">
				<label>@text/channel.BatteryPack#Power.label</label>
				<description>@text/channel.BatteryPack#Power.description</description>
			</channel>
			<channel id="Capacity" typeId="Energy_in_kWh">
				<label>@text/channel.BatteryPack#Capacity.label</label>
				<description>@text/channel.BatteryPack#Capacity.description</description>
			</channel>
			<channel id="NumberOfBatteries" typeId="NumberOf">
				<label>@text/channel.BatteryPack#NumberOfBatteries.label</label>
				<description>@text/channel.BatteryPack#NumberOfBatteries.description</description>
			</channel>
			<channel id="StateOfCharge" typeId="Level_in_perCent">
				<label>@text/channel.BatteryPack#StateOfCharge.label</label>
				<description>@text/channel.BatteryPack#StateOfCharge.description</description>
			</channel>
			<channel id="ChargeLevelMax" typeId="Level_in_perCent">
				<label>@text/channel.BatteryPack#hargeLevelMax.label</label>
				<description>@text/channel.BatteryPack#ChargeLevelMax.description</description>
			</channel>
			<channel id="DischargeLevelMin" typeId="Level_in_perCent">
				<label>@text/channel.BatteryPack#DischargeLevelMin.label</label>
				<description>@text/channel.BatteryPack#DischargeLevelMin.description</description>
			</channel>
			<channel id="RemainingDischargeTime" typeId="RemainingTime_in_min">
				<label>@text/channel.BatteryPack#RemainingDischargeTime.label</label>
				<description>@text/channel.BatteryPack#RemainingDischargeTime.description</description>
			</channel>
		</channels>
	</channel-group-type>

</thing:thing-descriptions>
