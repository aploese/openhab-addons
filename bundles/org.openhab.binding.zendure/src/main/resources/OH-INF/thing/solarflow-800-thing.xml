<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="zendure"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<channel-group-type id="Device_SolarFlow_800">
		<label>@text/channel-group-type.Device_SolarFlow_800.label</label>
		<channels>
			<channel id="FaultLevel" typeId="Device_FaultLevel"/>
			<channel id="IsError" typeId="Device_IsError"/>
			<channel id="Temperature" typeId="Temperature">
				<label>@text/channel.Device#Temperature.label</label>
				<description>@text/channel.Device#Temperature.description</description>
			</channel>
			<channel id="LampSwitch" typeId="Switch_On_Off">
				<label>@text/channel.Device#LampSwitch.label</label>
				<description>@text/channel.Device#LampSwitch.description</description>
			</channel>
			<channel id="SmartMode" typeId="Switch_On_Off">
				<label>@text/channel.Device#SmartMode.label</label>
				<description>@text/channel.Device#SmartMode.description</description>
			</channel>
			<channel id="RSSI" typeId="Device_RSSI"/>
		</channels>
	</channel-group-type>

	<bridge-type id="solarflow-800">
		<label>@text/thing-type.zendure.solarflow-800.label</label>
		<description>@text/thing-type.zendure.solarflow-800.description</description>

		<channel-groups>
			<channel-group id="PV" typeId="PV_2_Panels"/>
			<channel-group id="BatteryPack" typeId="BatteryPack"/>
			<channel-group id="Inverter_Mains" typeId="Inverter_Mains"/>
			<channel-group id="Device" typeId="Device_SolarFlow_800"/>
		</channel-groups>

		<properties>
			<!-- set if discovered by mDNS -->
			<property name="Zendure">Unknown</property>
		</properties>

		<representation-property>serialNumber</representation-property>

		<config-description>
			<parameter name="deviceIp" type="text">
				<label>Device IP Address</label>
				<description>IP Address of the Zendure json api (e.g. solarflow-800)</description>
				<default>solarflow-800</default>
				<required>true</required>
			</parameter>
			<parameter name="serialNumber" type="text">
				<label>Serial number</label>
				<description>The serial number of the device</description>
				<required>true</required>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="1">
				<label>Refresh Interval</label>
				<description>States how often a refresh shall occur (in s).</description>
				<default>10</default>
				<required>true</required>
			</parameter>
			<parameter name="port" type="integer">
				<label>Port</label>
				<description>The Port to use default is 80 (http).</description>
				<default>80</default>
				<required>true</required>
				<advanced>true</advanced>
			</parameter>
			<parameter name="jsonReadPropertyPath" type="text">
				<label>Read property path (JSON).</label>
				<description>The path to get the property values.</description>
				<default>/properties/report</default>
				<required>true</required>
				<advanced>true</advanced>
			</parameter>
			<parameter name="jsonWriteProperyPath" type="text">
				<label>Write property path (JSON).</label>
				<description>The path to set the property values.</description>
				<default>/properties/write</default>
				<required>true</required>
				<advanced>true</advanced>
			</parameter>
		</config-description>

	</bridge-type>

</thing:thing-descriptions>
